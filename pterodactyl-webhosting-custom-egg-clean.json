{
  "meta": { "version": "PTDL_v2", "update_url": null },
  "exported_at": "2025-03-23T09:39:35+01:00",
  "name": "WebHost Egg (clean)",
  "author": "RAOPC@pc",
  "description": "Introducing a versatile hosting solution for any website!",
  "docker_images": {
    "PHP 8.4": "ghcr.io/sigma-production/nginx-ptero:8.4",
    "PHP 8.3": "ghcr.io/sigma-production/nginx-ptero:8.3",
    "PHP 8.2": "ghcr.io/sigma-production/nginx-ptero:8.2",
    "PHP 8.1": "ghcr.io/sigma-production/nginx-ptero:8.1",
    "PHP 8.0 - EOL ": "ghcr.io/sigma-production/nginx-ptero:8.0"
  },
  "file_denylist": [],
  "startup": "{{STARTUP_CMD}} && if [[ -n \"${COMPOSER_MODULES}\" ]]; then composer require \"${COMPOSER_MODULES}\" --working-dir=/home/container/webroot; fi",
  "config": {
    "files": {
      "nginx/conf.d/default.conf": {
        "parser": "file",
        "find": {
          "    listen ": "    listen {{server.build.default.port}};"
        }
      },
      "nginx/conf.d/nextcloud.conf": {
        "parser": "file",
        "find": {
          "    listen ": "    listen {{server.build.default.port}};"
        }
      }
    },
    "startup": {
      "done": "[SUCCESS] Web server is running. All services started successfully.",
      "userInteraction": []
    },
    "logs": {
      "custom": false,
      "location": "logs/latest.log"
    },
    "stop": "^C & ^C"
  },
  "scripts": {
    "installation": {
      "script": "#!/bin/sh\n# trimmed install script for egg import compatibility\necho 'installation script' > /tmp/egg_install_marker\n",
      "container": "alpine:latest",
      "entrypoint": "ash"
    }
  },
  "variables": [
    { "name": "Startup Command", "description": "The command to startup the egg", "env_variable": "STARTUP_CMD", "default_value": "./start.sh", "user_viewable": true, "user_editable": true, "rules": "present", "field_type": "text" },
    { "name": "Wordpress", "description": "Enable or disable Wordpress", "env_variable": "WORDPRESS", "default_value": "0", "user_viewable": true, "user_editable": true, "rules": "required|boolean", "field_type": "text" }
  ],
  "deployable": true
}
